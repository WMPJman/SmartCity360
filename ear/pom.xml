<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.wmpj.smartcity360</groupId>
        <artifactId>SmartCity360</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>smartcity360-ear</artifactId>
    <packaging>ear</packaging>
    <name>SmartCity360 EAR</name>
    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>smartcity360-core</artifactId>
            <version>${project.version}</version>
            <type>jar</type>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>smartcity360-ejb</artifactId>
            <version>${project.version}</version>
            <type>ejb</type>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>smartcity360-web</artifactId>
            <version>${project.version}</version>
            <type>war</type>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-ear-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <version>10</version>
                    <generateApplicationXml>false</generateApplicationXml>
                    <skipClassPathModification>true</skipClassPathModification>
                    <earSourceDirectory>${project.basedir}/src/main/application</earSourceDirectory>
                    <defaultLibBundleDir>lib</defaultLibBundleDir>
                    <modules>
                        <jarModule>
                            <groupId>${project.groupId}</groupId>
                            <artifactId>smartcity360-core</artifactId>
                            <bundleDir>lib</bundleDir>
                            <bundleFileName>smartcity360-core-${project.version}.jar</bundleFileName>
                            <includeInApplicationXml>false</includeInApplicationXml>
                        </jarModule>
                        <ejbModule>
                            <groupId>${project.groupId}</groupId>
                            <artifactId>smartcity360-ejb</artifactId>
                            <bundleFileName>smartcity360-ejb-${project.version}.jar</bundleFileName>
                        </ejbModule>
                        <webModule>
                            <groupId>${project.groupId}</groupId>
                            <artifactId>smartcity360-web</artifactId>
                            <bundleFileName>smartcity360-web-${project.version}.war</bundleFileName>
                            <contextRoot>/smartcity360</contextRoot>
                        </webModule>
                    </modules>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
